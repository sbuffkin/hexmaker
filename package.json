{
  "name": "hexmaker-plugin",
  "version": "1.5.6",
  "description": "A plugin to power hex crawl worldbuilding and running.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:full": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production --full",
    "check:release": "node dev/release/check-release.mjs",
    "version": "node version-bump.mjs && npm run compat:snapshot && git add manifest.json versions.json tests/fixtures/compat",
    "compat:snapshot": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs tests/compat/snapshot.ts",
    "test": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "test:watch": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test --watch \"tests/*.test.ts\"",
    "test:integration": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test tests/integration/*.integration.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "smoke": "node dev/smoke/cli.mjs",
    "premerge": "node dev/smoke/premerge.mjs",
    "test:e2e": "tsx --tsconfig ./tsconfig.test.json --import ./tests/register.mjs --test tests/integration/e2e-*.integration.ts",
    "lint": "eslint . --ext .js,.ts",
    "obsidian:login": "node dev/obsidian-login.mjs",
    "preview:overworld": "esbuild dev/overworld-preview.ts --bundle --format=iife --loader:.md=text --define:__SLICE_WORLDMAPS__=true --define:__SLICE_SPACE__=true --define:__SLICE_HEXFLOWER__=true --outfile=dev/overworld-preview.js"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "Mark B",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.30.1",
    "@types/node": "^25.5.0",
    "esbuild": "0.27.4",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "expect": "^30.3.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
